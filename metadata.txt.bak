[general]
name = QdrawEVT
qgisMinimumVersion = 3.22
qgisMaximumVersion = 4.99
supportsQt6 = True
description = Easily draw and select entities within the drawing footprint
description[fr] = Dessinez et sélectionnez facilement des entités dans l'empreinte du dessin
version = 2.73
author = François Thévand
email = francois.thevand@gmail.com
homepage = https://github.com/fthvd/qdrawEVT
tracker = https://github.com/fthvd/qdrawEVT/issues
repository = https://github.com/fthvd/qdrawEVT
category = Vector
icon = icon.png
experimental = False
deprecated = False
about = QdrawEVT allows you to draw points, lines and polygons directly on the map and perform selections of intersecting layers. A dedicated help is available from the plugin menu.
about[fr] = QdrawEVT vous permet de dessiner des points, des lignes et des polygones directement sur la carte et d'effectuer des sélections de couches qui se croisent. Une aide dédiée est disponible depuis le menu du plugin.
tags = selection, vector, tools
tags[fr] = sélection, vecteur, outils
changelog = 2.72.2 : Corrections Flake8 et compatibilité Qt6/QGIS4 (enums scoped)
	2.72.1 : Mise en conformité conjointe Qgis3/Qgis4 - Plugin scan_qt6_compat
	2.72 Fix Qt5 startup compatibility: remove dependency on IO_READ_ONLY alias
	2.71 Bandit security scan corrections and safer Qt-based ODS/XML handling
	2.70 Correction of translation errors and Flake8 code corrections
	2.68 Developer mode fix
	2.67 Update to the crisis management configuration and integrated sample project
	2.66 : correction requiered by Qgis plugins server and correction of the coordinates entry window
	2.61 : Joint Qgis3/Qgis compliance - Scan_qt6_compat plugin - Removal of the resource.py file
	2.60 Fixed the selection bug in non-EVT mode and the bug that prevents the selected layers window from closing.
	2.58 Fixed the bug that caused the Drawings group to be created when opening any project and/or reloading the plugin.
	2.57 Fixed a bug that disabled the optional crisis management plugin tools when updating qdrawEVT
	2.56 Fixed a bug that caused a duplicate toolbar to be created after the update.
	2.55 General improvement of the ergonomics of the tools
	2.53 Bug fix for the annotation creation tool, translation corrections
	2.52 Fixed remaining bugs, improved group handling and selection logic
	2.51 Improved multi-selection, added global export to memory layers
	2.50 Major refactoring and stability improvements
